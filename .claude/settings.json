{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m intakeguard.worker:*)",
      "Bash(python -m evals:*)",
      "Bash(python scripts/mutation_check.py:*)",
      "Bash(ruff check:*)",
      "Bash(uvicorn:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(git config:*)",
      "Bash(pip install:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(//etc/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/scripts/**)",
      "Edit(/intakeguard/sql/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
